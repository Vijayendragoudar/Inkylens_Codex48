# Copy this file to .env for local development. Never commit .env.

# SQLite is the local-development default. Set a hosted database URL before deployment.
INKYLENS_DATABASE_URL=sqlite:///./inkylens.db

# Leave blank to run deterministic checks without external AI analysis.
OPENAI_API_KEY=
INKYLENS_OPENAI_MODEL=gpt-4o-mini
INKYLENS_AI_TIMEOUT_SECONDS=20
